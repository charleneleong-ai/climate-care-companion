# Copy to `.env` at the repo root and fill in. `.env` is gitignored; this file
# is not, so never put a real credential here.
#
# Everything below is optional in the sense that the risk engine runs without
# any of it — assessments, plans and the monitoring view need no keys at all.
# What these unlock is the ability to *reach* someone: messages, calls, and
# push. A missing variable disables a channel; it never silently degrades one.

# ── Push notifications ───────────────────────────────────────────────────────

# Generate a pair with `uv run python -m checkin.vapid`. The public half goes in
# web/app/.env.local as NEXT_PUBLIC_VAPID_PUBLIC_KEY; only the private half
# belongs here.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@climatise.example

# Required before POST /push/subscribe will accept anything. Unset means
# registration returns 503 rather than running open — without it, anyone who can
# reach the service could read GET /people, pick a name, and point their own
# phone at that person's health alerts. Any long random string will do.
CLIMATISE_PUSH_TOKEN=

# ── The scheduled sweep ──────────────────────────────────────────────────────

# Required before POST /cron/sweep will run. On Vercel this is generated for you
# and sent as `Authorization: Bearer …`; set it by hand anywhere else. Unset
# means the endpoint returns 503, because otherwise it is a button that sends
# real messages to real people, reachable by anyone who knows the path.
CRON_SECRET=

# ── Twilio: WhatsApp, SMS and voice ──────────────────────────────────────────

# TwilioChannel refuses to construct without the first three, rather than
# existing and quietly sending nothing.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_SENDER=whatsapp:+14155238886

# An approved WhatsApp template. Without it Twilio only delivers inside the
# 24-hour window opened by the recipient messaging first.
TWILIO_CONTENT_SID=

# The number outbound calls appear to come from.
TWILIO_VOICE_CALLER_ID=

# SC-6. A comma-separated allow-list of numbers this build may contact, and the
# only thing standing between a demonstrator and a real person's phone. Empty
# means send to nobody, which is the correct default: every persona in this repo
# is fictional, and the personal data of a real vulnerable adult must never
# reach it. Widen deliberately, one number at a time.
CLIMATISE_TWILIO_ALLOWED_RECIPIENTS=

# ── Voice service ────────────────────────────────────────────────────────────

# The publicly reachable base URL Twilio fetches TwiML from — a tunnel locally.
CLIMATISE_VOICE_URL=
CLIMATISE_WEBHOOK_URL=

# Which persona an inbound caller is treated as, before caller-ID matching.
CLIMATISE_VOICE_PERSON=doris

# Raises the forecast so the escalation path can be demonstrated on a mild day.
# Everything downstream is untouched — same rules, same corpus, same thresholds.
# CLIMATISE_VOICE_SIMULATE_PEAK=32

# DANGER: set to 1 only against a local tunnel. It disables verification of
# Twilio's request signature, so anyone who finds the webhook URL can post
# fabricated check-in answers — including a red flag that triggers an
# escalation, or a cheerful "I'm fine" that suppresses a real one.
# CLIMATISE_ALLOW_UNSIGNED_WEBHOOKS=1

# ── Where state is kept ──────────────────────────────────────────────────────

# Defaults write to /tmp, which is fine locally and wrong anywhere that restarts
# — /tmp is cleared, and a serverless invocation never sees the previous one's.
# Point these at a persistent volume, or set the Redis pair below instead.
# CLIMATISE_PUSH_STORE=/data/climatise-push.json
# CLIMATISE_CHECKIN_LOG=/data/climatise-checkins.json
# CLIMATISE_NOTIFY_STATE=/data/climatise-notify.json

# Upstash Redis. When set, these take precedence over the file paths above and
# writes become atomic, so concurrent workers stop overwriting each other.
# Vercel's integration injects the KV_ pair; Upstash's own dashboard gives the
# UPSTASH_ pair. Either is accepted. A URL without a token is refused at startup
# rather than failing on the first write.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
