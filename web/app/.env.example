# ── The assistant's brain ──────────────────────────────────────────────────
# Only ANTHROPIC_API_KEY is required. Everything else has a working default.
#
# You can also skip the key entirely for local dev by running `ant auth login`
# — the SDK picks up the stored profile automatically.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5.
# CLAUDE_MODEL=claude-opus-5

# ── Local-only mode (no external API calls) ────────────────────────────────
# Set to "ollama" to run the assistant against a local model instead.
# Note: only works when the browser and Ollama are on the same machine or
# network — deployed phone users cannot reach your laptop.
# LLM_PROVIDER=ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1

# ── The Python risk engine ─────────────────────────────────────────────────
# Where the core lives. Called server-side only — it is never shipped to the
# browser, which is why the core can stay on loopback in a container and on a
# private URL when deployed separately.
# CORE_API_URL=http://localhost:8000

# ── Push notifications ─────────────────────────────────────────────────────
# The public half of the VAPID pair; the private half goes in the repo-root
# .env. Generate both with `uv run python -m checkin.vapid`.
#
# Compiled into the bundle at build time rather than read at run time, so it has
# to be present when `npm run build` runs — setting it afterwards has no effect.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Not needed ─────────────────────────────────────────────────────────────
# Weather (Open-Meteo) and postcode lookup (postcodes.io) need no API keys.
